# Container/Images anzeigen
docker ps                    # laufende Container
docker ps -a                 # alle Container inkl. gestoppte
docker images                # alle Images

# Logs & Debug
docker logs <name>           # Logs eines Containers
docker logs -f <name>        # live follow
docker exec -it <name> bash  # Shell in Container öffnen
docker inspect <name>        # Details zu Container/Image

# Aufräumen
docker system prune -af --volumes  # ALLES löschen
docker volume prune -f             # nur Volumes
docker builder prune -af           # nur Build-Cache
docker compose logs -f

# Docker Compose Befehle
docker compose up -d          # starten im Hintergrund
docker compose up --build     # neu bauen und starten
docker compose down           # stoppen und Container löschen
docker compose down --volumes # + Volumes löschen (DB reset!)
docker compose logs -f        # alle Logs live
docker compose ps             # Status aller Services

